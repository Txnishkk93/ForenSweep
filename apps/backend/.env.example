NODE_ENV=development
PORT=4000
WS_PORT=4001
DATABASE_URL=postgresql://...
JWT_SECRET=replace-with-at-least-32-character-development-secret
JWT_EXPIRES_IN=8h
INTERNAL_WORKER_TOKEN=replace-with-at-least-32-character-internal-token
REDIS_URL=redis://localhost:6379
SAFE_IMAGE_ROOT=../../storage/safe-images
SAFE_OUTPUT_ROOT=../../storage/output
REAL_DEVICE_OPERATIONS=false
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
CERT_PUBLIC_KEY_PATH=./secrets/forensweep-ed25519-public.pem
