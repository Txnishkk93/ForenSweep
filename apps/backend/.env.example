NODE_ENV=development
PORT=4000
WS_PORT=4001
DATABASE_URL=postgresql://forensweep:forensweep-dev-only@localhost:5432/forensweep
JWT_SECRET=forensweep-demo-jwt-secret-32-characters-minimum
JWT_EXPIRES_IN=8h
INTERNAL_WORKER_TOKEN=forensweep-demo-worker-token-32-characters-min
REDIS_URL=redis://localhost:6379
SAFE_IMAGE_ROOT=../../storage/safe-images
SAFE_OUTPUT_ROOT=../../storage/output
REAL_DEVICE_OPERATIONS=false
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
CERT_PUBLIC_KEY_PATH=./secrets/forensweep-ed25519-public.pem
