BACKEND_INTERNAL_URL=http://localhost:4000
INTERNAL_WORKER_TOKEN=replace-with-at-least-32-character-internal-token
SAFE_IMAGE_ROOT=../../storage/safe-images
REAL_DEVICE_OPERATIONS=false
HARDWARE_DEMO_ENABLED=false
HARDWARE_DEMO_ALLOWED_METHOD=OVERWRITE_SINGLE
# Set these only for a private, disposable-device demo session.
# HARDWARE_DEMO_MAX_CAPACITY_BYTES=137438953472
# HARDWARE_DEMO_CONFIRM_PHRASE=
WORKER_CHUNK_SIZE=1048576
WORKER_SAMPLE_COUNT=16
CERT_PRIVATE_KEY_PATH=./secrets/forensweep-ed25519-private.pem
SAFE_OUTPUT_ROOT=../../storage/output
MAX_IMAGE_SIZE=1073741824
MAX_CANDIDATES=100
MAX_CANDIDATE_EXTRACTION_SIZE=52428800
MAX_SCAN_DURATION_SECONDS=60
