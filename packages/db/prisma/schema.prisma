datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         Role       @default(OPERATOR)
  createdAt    DateTime   @default(now())
  jobs         Job[]
  auditLogs    AuditLog[]
  approvedJobs Job[]      @relation("JobApproval")
}

enum Role {
  ADMIN
  OPERATOR
  INVESTIGATOR
}

enum JobType {
  ERASE
  RECOVER
}

enum JobStatus {
  QUEUED
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobStage {
  QUEUED
  RUNNING
  DEVICE_PROFILED
  WAITING_FOR_APPROVAL
  OVERWRITING
  SANITIZING
  CARVING
  VALIDATING
  RECONSTRUCTING
  VERIFYING
  CERTIFYING
  COMPLETED
  FAILED
}

enum DeviceType {
  HDD
  SSD
  USB
  SD_CARD
  UNKNOWN
}

enum EraseMethod {
  OVERWRITE_SINGLE
  OVERWRITE_MULTI
  ATA_SECURE_ERASE
  NVME_SECURE_FORMAT
  CRYPTO_ERASE
  FILE_LEVEL_OVERWRITE
}

enum EraseScope {
  WHOLE_DRIVE
  SPECIFIC_FILES
}

enum ScanType {
  QUICK
  DEEP
}

enum SanitizationStandard {
  NIST_800_88
  DOD_5220_22_M
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model Device {
  id                 String     @id @default(uuid())
  path               String
  type               DeviceType
  model              String?
  serial             String?
  sizeBytes          BigInt?
  supportsAta        Boolean    @default(false)
  supportsNvme       Boolean    @default(false)
  supportsSed        Boolean    @default(false)
  mounted            Boolean    @default(false)
  isSystemDisk       Boolean    @default(false)
  capabilitySnapshot Json?
  lastSeenAt         DateTime   @default(now())
  jobs               Job[]

  @@index([path])
  @@index([serial])
  @@index([type])
  @@index([isSystemDisk])
}

model Job {
  id                String                @id @default(uuid())
  type              JobType
  status            JobStatus             @default(QUEUED)
  stage             JobStage              @default(QUEUED)
  progress          Int                   @default(0)
  currentPass       Int                   @default(0)
  totalPasses       Int                   @default(0)
  progressDetail    Json
  deviceId          String?
  userId            String
  approvalStatus    ApprovalStatus        @default(NOT_REQUIRED)
  approvedById      String?
  approvedAt        DateTime?
  eraseMethod       EraseMethod?
  eraseScope        EraseScope?
  eraseFileList     Json?
  standard          SanitizationStandard?
  verified          Boolean?
  verificationData  Json?
  residualRiskScore Float?
  residualRiskLevel RiskLevel?
  scanType          ScanType?
  sourceImagePath   String?
  sourceHash        String?
  outputDirectory   String?
  errorMessage      String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime              @default(now())
  device            Device?               @relation(fields: [deviceId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])
  approvedBy        User?                 @relation("JobApproval", fields: [approvedById], references: [id])
  certificate       Certificate?
  recoveredFiles    RecoveredFile[]
  auditLogs         AuditLog[]

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([stage])
  @@index([approvalStatus])
}

model Certificate {
  id                  String               @id @default(uuid())
  certificateNumber   String               @unique
  jobId               String               @unique
  method              EraseMethod
  standard            SanitizationStandard
  verificationResult  Boolean
  verificationDetails Json?
  deviceSnapshot      Json
  canonicalPayload    Json
  contentHash         String
  hashAlgorithm       String
  signatureAlgorithm  String
  prevCertHash        String?
  signature           String
  pdfPath             String?
  createdAt           DateTime             @default(now())
  job                 Job                  @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model RecoveredFile {
  id              String          @id @default(uuid())
  jobId           String
  fileName        String?
  fileType        String
  mimeType        String?
  offsetStart     BigInt
  offsetEnd       BigInt
  isFragmented    Boolean         @default(false)
  isTruncated     Boolean         @default(false)
  fragmentCount   Int             @default(1)
  confidenceScore Float
  confidenceLevel ConfidenceLevel
  scoreBreakdown  Json?
  validationNotes Json?
  sha256          String?
  storedPath      String
  previewPath     String?
  createdAt       DateTime        @default(now())
  job             Job             @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  jobId        String?
  action       String
  detail       Json?
  previousHash String?
  eventHash    String
  signature    String?
  timestamp    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
  job          Job?     @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([jobId])
  @@index([timestamp])
  @@index([eventHash])
}
