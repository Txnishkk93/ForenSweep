# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files — block everything starting with .env, no exceptions
.env*

# Secrets — never commit
**/secrets/
*.pem
*.key
protected-devices.json
*confirm-phrase*

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# Storage — generated/runtime data, not source
storage/
**/storage/safe-images/
**/storage/output/
*.img

# Python worker
apps/forensic-worker/.venv/
apps/forensic-worker/__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# Prisma
packages/db/prisma/*.db
packages/db/prisma/migrations/dev/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store